### Progress Milestones

```tsx
// Celebrate at 25%, 50%, 75%, 100%
const milestones = [25, 50, 75, 100];
const reachedMilestone = milestones.find(m => 
  prevPercentage < m && percentage >= m
);

if (reachedMilestone) {
  toast.success(`${reachedMilestone}% complete! 💪`);
  triggerHaptic('success');
}
```

### Motivational Messages

```tsx
// Dynamic messages based on progress
const getMessage = (percentage: number) => {
  if (percentage === 0) return "Let's get started! 💪";
  if (percentage < 25) return "Great start!";
  if (percentage < 50) return "Keep pushing!";
  if (percentage < 75) return "Halfway there! 🔥";
  if (percentage < 100) return "Almost done!";
  return "Week complete! 🏆";
};
```

