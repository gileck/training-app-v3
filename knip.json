{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/pages/**/*.{ts,tsx}",
    "src/client/features/index.ts",
    "src/client/routes/index.ts",
    "src/client/components/project/**/*.{ts,tsx}",
    "src/apis/index.ts",
    "scripts/**/*.{ts,js}",
    "config/**/*.{ts,mjs,js}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,js}",
    "config/**/*.{ts,mjs,js}"
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.d.ts",
    "src/pages/api/**",
    "node_modules/**",
    "src/agents/lib/**",
    "src/server/s3/example.ts",
    "scripts/exercises-scripts/**"
  ],
  "ignoreDependencies": [
    "@types/*",
    "tailwindcss",
    "postcss",
    "eslint-config-next",
    "@playwright/mcp",
    "@anthropic-ai/claude-code",
    "aws-sdk",
    "date-fns",
    "undici",
    "react-day-picker"
  ],
  "ignoreExportsUsedInFile": true,
  "next": {
    "entry": [
      "src/pages/**/*.{ts,tsx}",
      "next.config.ts",
      "config/next/*.ts"
    ]
  }
}
